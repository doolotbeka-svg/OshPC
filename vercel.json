{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/render.ts": {
      "includeFiles": "dist-server/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/render" },
    { "source": "/robots.txt", "destination": "/api/seo?file=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?file=sitemap" }
  ]
}
